{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/security-guidance/hooks/security_reminder_hook.py"
          }
        ],
        "matcher": "Edit|Write|MultiEdit",
        "_apm_source": "security-guidance"
      }
    ],
    "sessionStart": [
      {
        "command": "./hooks/run-hook.cmd session-start",
        "_apm_source": "superpowers"
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" session-start",
            "async": false
          }
        ],
        "_apm_source": "superpowers"
      }
    ]
  }
}
